<UserControl x:Class="VDC_WPF_T.Windows.AuthWindow.CustomRadioButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <RadioButton x:Name="radioButton"
                     VerticalAlignment="Center" 
                     HorizontalAlignment="Left"
                     FontSize="15"
                     Content="{Binding PlaceholderText, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     GroupName="RadioGroup"
            Checked="RadioButton_Checked"
                     Margin="0,5,0,0"
                     >
            <RadioButton.Style>
                <Style TargetType="RadioButton">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Custom radio button ellipse -->
                                    <Grid Width="15" Height="15" Margin="5,0,10,0">
                                        <Ellipse Width="15" Height="15" Fill="Transparent" Stroke="Gray" StrokeThickness="1"/>
                                        <Ellipse Width="10" Height="10" Fill="Transparent" x:Name="InnerEllipse" />
                                    </Grid>

                                    <!-- Text next to the button -->
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <!-- Trigger for selected (checked) state -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="InnerEllipse" Property="Fill" Value="LightSeaGreen"/>
                                        <Setter TargetName="InnerEllipse" Property="Width" Value="10"/>
                                        <Setter TargetName="InnerEllipse" Property="Height" Value="10"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </RadioButton.Style>
        </RadioButton>
    </Grid>
</UserControl>
